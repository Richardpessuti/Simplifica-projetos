rules_version = '2';

// Regras de segurança do Firestore — Central de Cotações
//
// Como aplicar: Firebase Console → seu projeto → Firestore Database →
// aba "Regras" → cole este arquivo inteiro → Publicar.
//
// Resumo do modelo de acesso:
// - Nada é legível ou escrevível sem estar autenticado (login com e-mail/senha).
// - Um projeto (`projetos/{id}`) só é visível/editável por quem está no
//   `membrosEmails`, por quem criou (`criadoPor`), ou pelo master.
// - Tudo dentro de um projeto (cotações, prestadores, cronograma, arquivos
//   em pedaços etc.) herda essa mesma checagem, através de uma única regra
//   recursiva — não precisa listar cada subcoleção uma por uma.
// - `arquitetos` só é legível pelo próprio arquiteto (dono do cadastro) ou
//   pelo master — não é mais lido por clientes/membros de projeto, já que a
//   logo agora é gravada direto em `projetos/{id}.logoBase64` (propagada
//   sempre que o arquiteto atualiza a própria logo). Só o master cria/exclui
//   — um arquiteto pode atualizar o próprio cadastro (ex: trocar a logo).
// - `config/master` define quem é o master; só o master atual pode trocar.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    // E-mail do master fixo aqui (em vez de ler config/master a cada checagem)
    // — consultas de lista no Firestore não permitem depender de leitura de
    // outro documento pra decidir permissão. Se um dia trocar o e-mail
    // master pelo botão "Trocar e-mail master" no app, atualize essa linha
    // e publique as regras de novo.
    function isMaster() {
      return isSignedIn() && userEmail() == "richardpessuti@hotmail.com";
    }

    function isProjectAdmin(projetoData) {
      return isSignedIn() &&
        (projetoData.criadoPor is string && projetoData.criadoPor.lower() == userEmail() || isMaster());
    }

    // "ativo" (default true quando o campo não existe, pra não quebrar
    // projetos antigos criados antes disso existir) fica false quando uma
    // assinatura do Mercado Pago é cancelada/pausada — a Cloud Function seta
    // isso via Admin SDK. Master sempre passa direto, mesmo com o projeto
    // inativo (precisa continuar enxergando pra dar suporte).
    function isProjectMember(projetoData) {
      return isMaster() ||
        (
          projetoData.get('ativo', true) == true &&
          (isProjectAdmin(projetoData) ||
            (isSignedIn() && projetoData.membrosEmails is list && userEmail() in projetoData.membrosEmails))
        );
    }

    // ---------- config/master ----------
    match /config/master {
      allow get: if isSignedIn();
      allow list: if false;
      allow update: if isMaster();
      allow create, delete: if false; // documento é criado/mantido manualmente
    }

    // ---------- arquitetos ----------
    match /arquitetos/{arqId} {
      allow read: if isMaster() ||
        (isSignedIn() && resource.data.email is string && resource.data.email.lower() == userEmail());
      allow create, delete: if isMaster();
      // um arquiteto pode atualizar o próprio cadastro (ex: trocar a logo),
      // mas não pode mexer em "ativo" (só o master desativa/reativa — senão
      // uma arquiteta desativada conseguiria se reativar sozinha) nem trocar
      // o próprio "email" (identidade usada nas checagens de permissão em
      // outros lugares — só o master reatribui isso, se precisar)
      allow update: if isMaster() ||
        (isSignedIn() && resource.data.email is string && resource.data.email.lower() == userEmail() &&
          request.resource.data.get('ativo', true) == resource.data.get('ativo', true) &&
          request.resource.data.email == resource.data.email);
    }

    // ---------- dados legados de antes do login (sem dono definido) ----------
    // Usados só pelo botão "importar dados de antes do login" (migração
    // única, histórica). Não têm campo de dono, então não dá pra restringir
    // por usuário — liberado leitura pra qualquer autenticado, sem escrita
    // (o app só lê daqui pra copiar pra dentro de um projeto).
    match /cotacoes/{docId} { allow read: if isSignedIn(); allow write: if false; }
    match /arquiteta/{docId} { allow read: if isSignedIn(); allow write: if false; }
    match /prestadores/{docId} { allow read: if isSignedIn(); allow write: if false; }
    match /etapas/{docId} { allow read: if isSignedIn(); allow write: if false; }
    match /cronograma_arquivo/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /chunks/{chunkId} { allow read: if isSignedIn(); allow write: if false; }
    }

    // ---------- projetos e tudo dentro deles ----------
    match /projetos/{projetoId} {
      allow read: if isProjectMember(resource.data);

      // criadoPor precisa ser exatamente o e-mail de quem está criando (já em minúsculo,
      // por definição de userEmail()), e membrosEmails só pode conter esse mesmo e-mail
      // no momento da criação — evita depender só do app já mandar tudo em minúsculo.
      // "limiteIAMensal", "ativo" e "limiteMembros" não podem ser definidos na
      // criação — ficam de fora, e a Cloud Function/regra usa o padrão (franquia
      // normal, ativo, 3 pessoas).
      //
      // IMPORTANTE: criar projeto pelo cliente só é permitido pro master ou pra
      // quem é uma arquiteta de verdade cadastrada (referência real na coleção
      // "arquitetos", cujo e-mail bate com quem está criando) — sem essa trava,
      // qualquer conta nova (cadastro é aberto, sem convite) conseguiria criar
      // um projeto de graça pra si mesma, chamando o Firestore direto sem passar
      // pela tela. Os projetos dos clientes que pagam são criados pelo webhook
      // do Mercado Pago via Admin SDK, que ignora estas regras — essa trava aqui
      // não afeta esse fluxo, só fecha a brecha do lado do cliente.
      allow create: if isSignedIn() &&
        request.resource.data.criadoPor == userEmail() &&
        request.resource.data.membrosEmails == [userEmail()] &&
        !('limiteIAMensal' in request.resource.data) &&
        !('ativo' in request.resource.data) &&
        !('limiteMembros' in request.resource.data) &&
        (
          isMaster() ||
          (
            'arquitetoId' in request.resource.data &&
            get(/databases/$(database)/documents/arquitetos/$(request.resource.data.arquitetoId)).data.email is string &&
            get(/databases/$(database)/documents/arquitetos/$(request.resource.data.arquitetoId)).data.email.lower() == userEmail()
          )
        );

      allow update: if isMaster() ||
        (isProjectMember(resource.data) &&
          // impede que um membro comum se auto-promova a criador ou mude quem tem acesso;
          // só o admin do projeto pode alterar essas duas coisas
          (isProjectAdmin(resource.data) ||
            (request.resource.data.criadoPor == resource.data.criadoPor &&
             request.resource.data.membrosEmails == resource.data.membrosEmails)) &&
          // "limiteIAMensal", "ativo" e "limiteMembros" só o master (ou a Cloud
          // Function via Admin SDK) mudam — ninguém se autoconcede mais leituras
          // por IA, se reativa sozinho depois de uma assinatura cancelada, ou se
          // autoconcede mais vagas de acesso sem pagar por elas
          request.resource.data.get('limiteIAMensal', null) == resource.data.get('limiteIAMensal', null) &&
          request.resource.data.get('ativo', true) == resource.data.get('ativo', true) &&
          request.resource.data.get('limiteMembros', 3) == resource.data.get('limiteMembros', 3) &&
          // só bloqueia CRESCER membrosEmails além do limite do projeto — nunca
          // bloqueia remover gente nem mexer em outros campos, mesmo num projeto
          // que por algum motivo já tenha mais gente que o limite atual
          (request.resource.data.membrosEmails.size() <= resource.data.get('limiteMembros', 3) ||
           request.resource.data.membrosEmails.size() <= resource.data.membrosEmails.size()));

      allow delete: if isProjectAdmin(resource.data);

      // contagem de uso da leitura por IA, por mês, deste projeto — só a
      // Cloud Function (via Admin SDK, que ignora estas regras) escreve
      // aqui; qualquer membro do projeto pode ler, pra saber quanto já usou
      match /usoIA/{mes} {
        allow read: if isProjectMember(get(/databases/$(database)/documents/projetos/$(projetoId)).data);
        allow write: if false;
      }

      // Cotações, prestadores, etapas, arquivos da arquiteta, cronograma,
      // projeto 3D e os "chunks" de arquivo de cada um — tudo dentro do
      // projeto segue a mesma regra: precisa ser membro/admin/master.
      //
      // IMPORTANTE: um wildcard recursivo aninhado (`{document=**}`) também
      // bate com zero segmentos extras — ou seja, também bateria com o PRÓPRIO
      // documento do projeto (`projetos/{projetoId}`), e regras do Firestore
      // liberam acesso se QUALQUER regra que bate no caminho permitir (não é
      // "a mais específica vence"). Por isso exigimos pelo menos uma
      // coleção+doc antes do wildcard, e excluímos "usoIA" explicitamente —
      // senão essa regra genérica anularia tanto a trava do limiteIAMensal
      // quanto a proteção de escrita da contagem de uso acima.
      match /{colecao}/{docId}/{document=**} {
        allow read, write: if colecao != 'usoIA' &&
          isProjectMember(get(/databases/$(database)/documents/projetos/$(projetoId)).data);
      }
    }
  }
}
